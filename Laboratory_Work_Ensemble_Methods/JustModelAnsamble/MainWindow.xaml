<Window x:Class="JustModelAnsamble.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Прогноз урожая · Дерево решений"
        Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0B1220"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Анимация появления карточек -->
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.6"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="30" To="0" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🌱 Прогноз урожая"
                       FontSize="34" FontWeight="Bold"
                       Foreground="{StaticResource HeaderGradient}"/>
            <TextBlock Text="Модель на основе дерева решений (CART)"
                       Foreground="#94A3B8" FontSize="14" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- Левая карточка: параметры -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}"
                    Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard Storyboard="{StaticResource FadeIn}"/>
                    </EventTrigger>
                </Border.Triggers>

                <StackPanel>
                    <TextBlock Text="Входные параметры"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="#E2E8F0" Margin="0,0,0,16"/>

                    <TextBlock Text="Температура (°C)" Foreground="#94A3B8"/>
                    <Slider x:Name="TempSlider" Minimum="0" Maximum="40" Value="22"
                            Style="{StaticResource ModernSlider}"
                            ValueChanged="Slider_ValueChanged"/>
                    <TextBlock Text="{Binding ElementName=TempSlider, Path=Value, StringFormat={}{0:F1} °C}"
                               Foreground="#4ADE80" FontWeight="Bold" Margin="0,0,0,10"/>

                    <TextBlock Text="Осадки (мм)" Foreground="#94A3B8"/>
                    <Slider x:Name="RainSlider" Minimum="0" Maximum="800" Value="400"
                            Style="{StaticResource ModernSlider}"
                            ValueChanged="Slider_ValueChanged"/>
                    <TextBlock Text="{Binding ElementName=RainSlider, Path=Value, StringFormat={}{0:F0} мм}"
                               Foreground="#22D3EE" FontWeight="Bold" Margin="0,0,0,10"/>

                    <TextBlock Text="Влажность почвы (%)" Foreground="#94A3B8"/>
                    <Slider x:Name="MoistSlider" Minimum="10" Maximum="90" Value="55"
                            Style="{StaticResource ModernSlider}"
                            ValueChanged="Slider_ValueChanged"/>
                    <TextBlock Text="{Binding ElementName=MoistSlider, Path=Value, StringFormat={}{0:F0} %}"
                               Foreground="#A78BFA" FontWeight="Bold" Margin="0,0,0,10"/>

                    <TextBlock Text="pH почвы" Foreground="#94A3B8"/>
                    <Slider x:Name="PhSlider" Minimum="4" Maximum="9" Value="6.5"
                            Style="{StaticResource ModernSlider}"
                            ValueChanged="Slider_ValueChanged"/>
                    <TextBlock Text="{Binding ElementName=PhSlider, Path=Value, StringFormat={}{0:F1}}"
                               Foreground="#F472B6" FontWeight="Bold" Margin="0,0,0,10"/>

                    <Button Content="Обучить модель заново"
                            Style="{StaticResource GradientButton}"
                            Margin="0,14,0,0"
                            Click="Retrain_Click"/>
                </StackPanel>
            </Border>

            <!-- Правая карточка: результат -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}"
                    Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard Storyboard="{StaticResource FadeIn}"/>
                    </EventTrigger>
                </Border.Triggers>

                <StackPanel>
                    <TextBlock Text="Прогноз"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="#E2E8F0" Margin="0,0,0,16"/>

                    <Border CornerRadius="14" Padding="24"
                            Background="#0F1A2E">
                        <StackPanel>
                            <TextBlock Text="Ожидаемая урожайность"
                                       Foreground="#94A3B8" FontSize="13"/>
                            <TextBlock x:Name="YieldText"
                                       Text="0.0 ц/га"
                                       FontSize="46" FontWeight="Bold"
                                       Foreground="{StaticResource HeaderGradient}"/>

                            <ProgressBar x:Name="YieldBar"
                                         Height="10" Margin="0,12,0,0"
                                         Minimum="0" Maximum="120"
                                         Value="0"
                                         Foreground="{StaticResource HeaderGradient}"
                                         Background="#1E293B"
                                         BorderThickness="0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Уровень риска" Foreground="#94A3B8" Margin="0,20,0,6"/>
                    <TextBlock x:Name="RiskText" Text="—"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="#FBBF24"/>

                    <TextBlock Text="Рекомендации" Foreground="#94A3B8" Margin="0,20,0,6"/>
                    <TextBlock x:Name="AdviceText" Text="—"
                               Foreground="#E2E8F0" TextWrapping="Wrap"
                               LineHeight="22"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
